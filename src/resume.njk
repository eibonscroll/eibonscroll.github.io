---
layout: layouts/base.njk
title: Resume
description: "Forward Deployed Engineer — real-time & applied-AI systems. Unreal Engine, C++, agentic AI, UI/HMI, and simulation."
permalink: /resume/
---
<div class="page resume">

  <header class="resume-hero">
    <div class="resume-hero__id">
      <div class="monogram" aria-hidden="true">MP</div>
      <div class="resume-hero__text">
        <h1>{{ resume.basics.name }}</h1>
        <div class="label">{{ resume.basics.label }}</div>
        <div class="contact">
          {% if resume.basics.location %}
          <span class="contact__item">{{ resume.basics.location.city }}{% if resume.basics.location.region %}, {{ resume.basics.location.region }}{% endif %} · open to remote</span>
          {% endif %}
          {% if resume.basics.email %}<a class="contact__item" href="mailto:{{ resume.basics.email }}">{{ resume.basics.email }}</a>{% endif %}
        </div>
      </div>
    </div>

    <div class="resume-hero__actions">
      <a class="button button--accent" href="/Michael-Purvis-Resume.pdf" download>Download résumé (PDF)</a>
      {% for p in resume.basics.profiles %}
      <a class="button" href="{{ p.url }}" target="_blank" rel="noopener">{{ p.network }}</a>
      {% endfor %}
    </div>
  </header>

  {% if resume.stats | length %}
  <div class="stat-grid">
    {% for s in resume.stats %}
    <div class="stat">
      <div class="stat__label">{{ s.label }}</div>
      <div class="stat__value">{{ s.value }}</div>
    </div>
    {% endfor %}
  </div>
  {% endif %}

  {% if resume.basics.summary %}
  <section class="summary">
    <p>{{ resume.basics.summary }}</p>
  </section>
  {% endif %}

  <section>
    <h2>Skills</h2>
    {% for s in resume.skills %}
    <div class="skill-group">
      <div class="skill-group__name">{{ s.name }}</div>
      <div class="chips">
        {% for k in (s.keywords or []) %}<span class="chip">{{ k }}</span>{% endfor %}
      </div>
    </div>
    {% endfor %}
  </section>

  {% if resume.projects | length %}
  <section>
    <h2>Selected Work</h2>
    <div class="work-strip">
      {% for p in resume.projects %}
      {% if p.image %}
      <a class="work-card{% if not p.url %} work-card--static{% endif %}"{% if p.url %} href="{{ p.url }}" target="_blank" rel="noopener"{% endif %}>
        <img class="work-card__img" src="{{ p.image }}" alt="{{ p.name }}" loading="lazy"/>
        <div class="work-card__body">
          <div class="work-card__title">{{ p.name }}</div>
          <div class="work-card__entity">{{ p.entity }}</div>
        </div>
      </a>
      {% endif %}
      {% endfor %}
    </div>
  </section>
  {% endif %}

  <section>
    <h2>Experience</h2>
    {% for w in resume.work %}
    {% if w.startDate >= "2017" %}
    <div class="item">
      <div class="item__head">
        <div class="hdr">{{ w.position }} · {{ w.name }}</div>
        <div class="dates">{{ w.startDate | monthYear }} – {% if w.endDate %}{{ w.endDate | monthYear }}{% else %}Present{% endif %}</div>
      </div>
      {% if w.summary %}<div class="item__summary">{{ w.summary }}</div>{% endif %}
      {% if w.highlights | length %}
      <ul>{% for h in w.highlights %}<li>{{ h }}</li>{% endfor %}</ul>
      {% endif %}
      {% if w.callout %}
      <div class="callout">
        <span class="callout__value">{{ w.callout.value }}</span>
        <span class="callout__note">{{ w.callout.note }}</span>
      </div>
      {% endif %}
    </div>
    {% endif %}
    {% endfor %}

    <h3 class="earlier-head">Earlier Experience</h3>
    <div class="timeline">
      {% for w in resume.work %}
      {% if w.startDate < "2017" %}
      <div class="timeline__row">
        <div class="timeline__date">{{ w.startDate | monthYear }} – {% if w.endDate %}{{ w.endDate | monthYear }}{% else %}Present{% endif %}</div>
        <div class="timeline__body"><span class="timeline__role">{{ w.position }}</span> · {{ w.name }}{% if w.summary %}<span class="timeline__note"> — {{ w.summary }}</span>{% endif %}</div>
      </div>
      {% endif %}
      {% endfor %}
    </div>
  </section>

  <section>
    <h2>Education</h2>
    {% for e in resume.education %}
    <div class="item">
      <div class="item__head">
        <div class="hdr">{{ e.institution }}</div>
        <div class="dates">{{ e.startDate | monthYear }} – {{ e.endDate | monthYear }}</div>
      </div>
      <div><em>{{ e.studyType }} — {{ e.area }}</em>{% if e.score %} · GPA {{ e.score }}{% endif %}</div>
    </div>
    {% endfor %}
  </section>

  {% if resume.certificates | length %}
  <section>
    <h2>Certifications</h2>
    <div class="chips chips--cert">
      {% for c in resume.certificates %}
      <span class="chip chip--cert">{{ c.name }}{% if c.issuer %} · <span class="muted">{{ c.issuer }}</span>{% endif %}</span>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {% if resume.volunteer | length %}
  <section>
    <h2>Service</h2>
    {% for v in resume.volunteer %}
    <div class="item">
      <div class="item__head">
        <div class="hdr">{{ v.position }}, {{ v.organization }}</div>
        <div class="dates">{{ v.startDate | monthYear }} – {{ v.endDate | monthYear }}</div>
      </div>
      {% if v.summary %}<div class="item__summary">{{ v.summary }}</div>{% endif %}
    </div>
    {% endfor %}
  </section>
  {% endif %}

</div>
