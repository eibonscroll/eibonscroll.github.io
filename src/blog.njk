---
layout: layouts/base.njk
title: Blog
permalink: /blog/
---
<div class="page">
  <h1 class="sr-only">Blog</h1>

  <nav class="blog-hero" aria-label="Context Arcana sites">
    <a class="blog-hero__card" href="https://contextarcana.com" rel="noopener">
      <span class="blog-hero__title">Implementation</span>
      <span class="blog-hero__domain">contextarcana.com</span>
    </a>
    <a class="blog-hero__card" href="https://contextarchitecturesystem.com" rel="noopener">
      <span class="blog-hero__title">Open Source</span>
      <span class="blog-hero__domain">contextarchitecturesystem.com</span>
    </a>
    <a class="blog-hero__card" href="https://contextcollection.com/" rel="noopener">
      <span class="blog-hero__title">Products</span>
      <span class="blog-hero__domain">contextcollection.com</span>
    </a>
  </nav>

  {% if collections.posts | length %}
  <ul class="post-cards">
    {% for post in collections.posts %}
    <li class="post-card">
      <a class="post-card__link" href="{{ post.url }}">
        {% if post.data.image %}
        <img class="post-card__media"
             src="{{ post.data.image }}"
             alt="{{ post.data.imageAlt | default('') }}"
             loading="lazy" decoding="async" width="1600" height="1000"/>
        {% else %}
        <span class="post-card__media post-card__media--empty" aria-hidden="true"></span>
        {% endif %}
        <span class="post-card__body">
          <span class="post-card__date">{{ post.date | readableDate }}</span>
          <span class="post-card__title">{{ post.data.title }}</span>
          {% if post.data.description %}
          <span class="post-card__excerpt">{{ post.data.description }}</span>
          {% endif %}
        </span>
      </a>
    </li>
    {% endfor %}
  </ul>
  {% else %}
  <p class="muted">Posts will appear here as they are published.</p>
  {% endif %}
</div>
