---
layout: layouts/base.njk
title: Blog
permalink: /blog/
---
<div class="page">
  <header>
    <h1>Blog</h1>
    <p class="muted">Writing on software engineering, AI-assisted development, and game technology.</p>
  </header>

  {% if collections.posts | length %}
  <ul class="post-cards">
    {% for post in collections.posts %}
    <li class="post-card">
      <a class="post-card__link" href="{{ post.url }}">
        {% if post.data.image %}
        <img class="post-card__media"
             src="{{ post.data.image }}"
             alt="{{ post.data.imageAlt | default('') }}"
             loading="lazy" decoding="async" width="1600" height="1000"/>
        {% else %}
        <span class="post-card__media post-card__media--empty" aria-hidden="true"></span>
        {% endif %}
        <span class="post-card__body">
          <span class="post-card__date">{{ post.date | readableDate }}</span>
          <span class="post-card__title">{{ post.data.title }}</span>
          {% if post.data.description %}
          <span class="post-card__excerpt">{{ post.data.description }}</span>
          {% endif %}
        </span>
      </a>
    </li>
    {% endfor %}
  </ul>
  {% else %}
  <p class="muted">Posts will appear here as they are published.</p>
  {% endif %}
</div>
